    family-names: Vaz Reay
    orcid: "https://orcid.org/0009-0001-0373-0047"
    affiliation: >-
      Centro Nacional de Investigaciones Oncológicas / Universitat de
      Girona
  # Additional authors/contributors to be added here as they join.
